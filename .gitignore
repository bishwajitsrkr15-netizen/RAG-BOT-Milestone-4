!data/loaded/.gitkeep
!data/chunks/.gitkeep
!data/embeddings/.gitkeep
!data/chroma/.gitkeep
!data/manifests/.gitkeep
!data/manifests/chunk-latest.json
!data/manifests/load-latest.json
!data/manifests/vector-store-current.json
